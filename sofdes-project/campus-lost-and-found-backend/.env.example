# Copy to .env and replace placeholders. Never commit actual credentials.
NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=replace_with_postgresql_user
DB_PASSWORD=replace_with_database_password
DB_NAME=campus_lost_and_found
DB_CONNECTION_LIMIT=10
# Set true for a hosted database requiring TLS; certificates are verified.
DB_SSL=false
# Optional PEM CA certificate supplied by your database provider.
DB_SSL_CA=
JWT_SECRET=replace_with_a_random_signing_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# Demo commands require BOTH development mode and this explicit flag.
ENABLE_DEMO_DATA=false
# Set your own password only when running the demo commands; no default.
DEMO_PASSWORD=

# Only for the separately confirmed destructive reset command. Leave false.
ALLOW_DATABASE_RESET=false
